# Postgres. In dev-profile Docker, host is localhost; in prod profile, host is `db`.
DATABASE_URL=postgresql://theorytracker:theorytracker@localhost:5432/theorytracker

# Auth.js secret — REQUIRED, and must be unique per deployment.
# Generate with:  openssl rand -base64 32
# This key signs session cookies. Anyone who knows it can mint a session for any
# account, so never ship the placeholder below and never commit a real one.
AUTH_SECRET=change-me

# Public URL of the app (prod: https://$DOMAIN). Auth.js builds callback URLs
# from this, so a wrong value breaks login rather than failing loudly.
AUTH_URL=http://localhost:3000

# Prod only: domain for Caddy automatic HTTPS
DOMAIN=example.com

# ---------------------------------------------------------------------------
# Self-hosting notes
#
# - Registration is invite-only except for the very first account, which
#   bootstraps the instance. Create that account immediately after first boot;
#   until you do, anyone who reaches the app can claim it.
# - Rate limits are in-process: they reset on restart and are NOT shared between
#   replicas. Run a single app container, or move lib/rate-limit.ts to a shared
#   store first.
# - /api/health is unauthenticated and reports only whether the DB answers.
#   Point your healthcheck or uptime monitor at it.
# - Back up with the per-series JSON export (settings page). It excludes
#   memberships, sessions, reading positions and invites by design, so it is a
#   content backup, not a full instance backup — for that, dump Postgres.
